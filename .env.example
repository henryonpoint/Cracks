# --- Database (Postgres) ---
# Neon or Supabase connection string. For local dev, any Postgres works.
DATABASE_URL="postgresql://user:password@host:5432/interest_dump?sslmode=require"

# --- Claude API (yours) ---
# From https://console.anthropic.com/ . This is the key the app bills against.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Capture auth (single-user v1) ---
# A long random secret. Sent by the phone Shortcut / Android share target /
# bookmarklet to authorize /api/capture. Generate one, e.g.:
#   openssl rand -hex 24
CAPTURE_TOKEN="change-me-to-a-long-random-string"

# --- Cron (optional) ---
# Vercel injects this automatically for scheduled Cron requests. If you set it,
# the /api/process retry endpoint accepts it. Leave unset to trigger by hand
# with the CAPTURE_TOKEN instead.
# CRON_SECRET="another-long-random-string"
