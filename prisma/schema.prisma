// Cracks — data model.
// v1 uses Item / Summary / Topic / ItemTopic. InterestProfile and Resurfacing are
// created now but populated by later iterations, so no schema rewrite is needed then.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  article
  social
  product
  email
  note
  unknown
}

enum ItemStatus {
  pending
  processing
  processed
  failed
}

model Item {
  id         String     @id @default(cuid())
  url        String?
  title      String?
  rawText    String?    // clean extracted text, or user-pasted note text
  sourceType SourceType @default(unknown)
  status     ItemStatus @default(pending)
  error      String?    // last failure reason, if any
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  summary      Summary?
  topics       ItemTopic[]
  resurfacings Resurfacing[]

  @@index([status])
  @@index([createdAt])
}

model Summary {
  id          String   @id @default(cuid())
  itemId      String   @unique
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  summary     String
  keyPoints   String[] // bullet takeaways
  readingMins Int?
  why         String?  // one line on why this might matter to you
  createdAt   DateTime @default(now())
}

model Topic {
  id    String      @id @default(cuid())
  name  String
  slug  String      @unique
  items ItemTopic[]

  @@index([slug])
}

model ItemTopic {
  itemId  String
  topicId String
  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([itemId, topicId])
  @@index([topicId])
}

// A rolling model of your interests: one row per theme with a recency-weighted
// score computed from how often (and how recently) you save related things.
model InterestProfile {
  id        String   @id @default(cuid())
  theme     String   @unique // matches a Topic.name
  slug      String   @unique // matches a Topic.slug
  weight    Float    @default(0) // recency-decayed frequency
  itemCount Int      @default(0)
  lastSeen  DateTime?
  updatedAt DateTime @updatedAt

  @@index([weight])
}

// A Claude-synthesized narrative over your interests ("what you're into lately").
// Append-only; the newest row is what the /insights page shows.
model Insight {
  id        String   @id @default(cuid())
  kind      String   @default("digest")
  narrative String   // prose summary of your current interests
  themes    String[] // headline themes, most salient first
  emerging  String[] // themes trending up
  fading    String[] // themes trending down
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Scheduled "bubble-ups" — resurface a past item at a chosen time.
model Resurfacing {
  id        String    @id @default(cuid())
  itemId    String
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dueAt     DateTime
  reason    String?
  shownAt   DateTime?
  dismissed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([dueAt])
  @@index([itemId])
}
