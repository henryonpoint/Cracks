// Interest Dump — data model.
// v1 uses Item / Summary / Topic / ItemTopic. InterestProfile and Resurfacing are
// created now but populated by later iterations, so no schema rewrite is needed then.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  article
  social
  product
  email
  note
  unknown
}

enum ItemStatus {
  pending
  processing
  processed
  failed
}

model Item {
  id         String     @id @default(cuid())
  url        String?
  title      String?
  rawText    String?    // clean extracted text, or user-pasted note text
  sourceType SourceType @default(unknown)
  status     ItemStatus @default(pending)
  error      String?    // last failure reason, if any
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  summary Summary?
  topics  ItemTopic[]

  @@index([status])
  @@index([createdAt])
}

model Summary {
  id          String   @id @default(cuid())
  itemId      String   @unique
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  summary     String
  keyPoints   String[] // bullet takeaways
  readingMins Int?
  why         String?  // one line on why this might matter to you
  createdAt   DateTime @default(now())
}

model Topic {
  id    String      @id @default(cuid())
  name  String
  slug  String      @unique
  items ItemTopic[]

  @@index([slug])
}

model ItemTopic {
  itemId  String
  topicId String
  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([itemId, topicId])
  @@index([topicId])
}

// ---- Reserved for later iterations (created now, populated later) ----

// A rolling model of your interests: one row per theme with a weight that
// grows as you save related things. Fed by Topic frequency + recency.
model InterestProfile {
  id        String   @id @default(cuid())
  theme     String   @unique
  weight    Float    @default(0)
  updatedAt DateTime @updatedAt
}

// Scheduled "bubble-ups" — resurface a past item at a chosen time.
model Resurfacing {
  id        String   @id @default(cuid())
  itemId    String
  dueAt     DateTime
  reason    String?
  shownAt   DateTime?
  createdAt DateTime @default(now())

  @@index([dueAt])
}
